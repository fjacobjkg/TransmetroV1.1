MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
MYSQL_DATABASE=transmetro_v1_original
MYSQL_USER=transmetro_app
MYSQL_PASSWORD=replace-with-a-local-app-password
DATABASE_URL=mysql://transmetro_app:replace-with-a-local-app-password@mysql:3306/transmetro_v1_original
CORS_ORIGIN=http://localhost:5174
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=3600
